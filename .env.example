# Порт HTTP-сервера
PORT=3000

# Адрес OpenAI-совместимого API (Chat Completions).
# Примеры:
#   OpenAI:          https://api.openai.com/v1
#   Ollama локально: http://127.0.0.1:11434/v1
#   LM Studio:       http://127.0.0.1:1234/v1
# Для локальных серверов указывайте 127.0.0.1, а не localhost: Ollama слушает
# только IPv4, а Node с версии 18 резолвит localhost в IPv6-адрес ::1,
# из-за чего запрос падает с ошибкой "fetch failed".
LLM_BASE_URL=http://127.0.0.1:11434/v1

# Ключ API (для локальной Ollama можно оставить пустым)
LLM_API_KEY=

# Имя модели
LLM_MODEL=qwen2.5-coder:7b

# Модель эмбеддингов для режима RAG (поиск по документации).
# Например, для Ollama: nomic-embed-text (ollama pull nomic-embed-text).
# Если не задана - используется лексический поиск BM25 без модели.
LLM_EMBED_MODEL=

# Каталог с документацией проекта (Markdown-файлы) для режима RAG
DOCS_DIR=./docs

# Температура генерации (0 - детерминированно, 1 - креативно)
LLM_TEMPERATURE=0.2

# Максимальная длина ответа модели в токенах (0 - без ограничения).
# Локальная модель выдаёт несколько токенов в секунду, поэтому предел
# длины напрямую ограничивает время ожидания.
LLM_MAX_TOKENS=1200

# Тайм-аут ожидания данных от модели в миллисекундах.
# Считается как простой: при потоковой генерации таймер взводится заново
# на каждом полученном фрагменте, поэтому длинный ответ не обрывается.
# Для непотокового режима это ограничение на весь ответ целиком -
# медленным локальным моделям нужно заметно больше: 7B на CPU выдаёт
# около 8 токенов в секунду, то есть ответ в 500 токенов - это минута.
LLM_TIMEOUT_MS=300000

# Демонстрационный режим без обращения к модели (1 - включён)
LLM_MOCK=0

# Ограничение числа запросов с одного IP в минуту
RATE_LIMIT_PER_MINUTE=20
